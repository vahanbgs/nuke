# What stands to the left of the dot is a value, so an import is projected
# without being bound first. `<|` binds loosest of all and `|>` looser than the
# dot, so the group is what hands the dot the imported document rather than the
# path — and naming the same file twice is reuse, not a second reading of it.
[
	(@import <| "../modules/palette.nuke").accent
	("../modules/palette.nuke" |> @import).muted
]
