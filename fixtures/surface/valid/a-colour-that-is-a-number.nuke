# A dot file colour is text, `#` opening a comment, so a colour written as a
# number reaches its readers through a radix — and is written in one now that
# `{n:06X}` and `0xFE8019` are each other's mirror.
accent := 0xFE8019

{
	alacritty = {cursor = $"#{accent:06X}"}
	ghostty = {palette = $"0=#{accent:06X}"}
	fish = {fish_color_command = $"{accent:06x}"}
}
