# A dot file colour is text, `#` opening a comment, so a colour written as a
# number reaches its readers through a radix. `{n:06X}` is the mirror of the hex
# literals the plan still owes, and the two should read alike when it pays them.
accent := 16678937

{
  alacritty = {cursor = $"#{accent:06X}"}
  ghostty = {palette = $"0=#{accent:06X}"}
  fish = {fish_color_command = $"{accent:06x}"}
}
